# Copie estas variáveis para: Vercel > seu projeto > Settings > Environment Variables
# NUNCA coloque os valores reais no GitHub.

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=chave-anon-public
SUPABASE_SERVICE_ROLE_KEY=chave-service_role-secreta

# Texto aleatório com 32+ caracteres (assina o login do painel)
SESSAO_SEGREDO=troque-por-um-texto-longo-e-aleatorio

# E-mail do domínio (dados no painel da hospedagem de e-mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=atendimento@lippmannts.com
SMTP_PASS=senha-do-email
SMTP_REMETENTE=atendimento@lippmannts.com

# Endereço público do site (links nos e-mails)
URL_SITE=https://www.lippmannts.com

# Opcionais
CONTAS_AGENDA=atendimento@lippmannts.com,comercial@lippmannts.com
GITHUB_REPO_URL=https://github.com/SEU-USUARIO/lippmannts

# Tarefas automáticas diárias (prazo de 30 dias do EaD e revogação após 12 meses). Texto aleatório com 32+ caracteres.
CRON_SECRET=

# Mercado Pago (checkout da UniLTS). Sem estas três, o checkout funciona em modo de simulação (nada é cobrado).
# Credenciais de teste começam com TEST- (sandbox). Webhook: https://lippmannts.com/api/pagamento?acao=webhook (evento Pagamentos)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ---------- FASE 7 ----------
# LIPP · assistente virtual com IA (Claude). Sem a chave, o LIPP responde pela base de conhecimento do site.
ANTHROPIC_API_KEY=
LIPP_MODELO=claude-haiku-5-5

# Google Agenda + Google Meet da conta comercial@lippmannts.com (OAuth). Sem estas três, os pedidos de reunião ficam "a confirmar".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Avaliações do Google (carrossel da página inicial · ficha oficial CdmducEbhRvCEAE · cache de 24 h).
# Sem a chave, aparecem os depoimentos fixos com a nota 4,9.
# GOOGLE_PLACE_ID é opcional: o padrão já é o Place ID oficial da LIPPMANN (ChIJD_H4-aMgJ1wR2Z25wRuFG8I).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJD_H4-aMgJ1wR2Z25wRuFG8I
